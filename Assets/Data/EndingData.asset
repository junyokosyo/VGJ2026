  Endings:
  - Type: 3
    Label: TRUE END
    Lines: "\u5FD8\u308C\u3066\u307B\u3057\u304B\u3063\u305F\u306E\u3067\u306F\u306A\u3044\u3002\n\u5F85\u3061\u7D9A\u3051\u3066\u307B\u3057\u304F\u306A\u304B\u3063\u305F\u3002\n\n\u9CE5\u306F\u59BB\u306E\u624B\u304B\u3089\u3001\u5A18\u306E\u3082\u3068\u3078\u5C4A\u3051\u3089\u308C\u305F\u3002"
    Letter: "\u3072\u306A\u3078\n\n\u3053\u308C\u3092\u6E21\u3059\u3053\u308D\u306B\u306F\u3001\u30D1\u30D1\u306F\u3082\u3046\u4E00\u7DD2\u306B\u904A\u3079\u306A\u3044\u304B\u3082\u3057\u308C\u306A\u3044\u3002\n\n\u3067\u3082\u3001\u3053\u306E\u9CE5\u306F\u305A\u3063\u3068\u3072\u306A\u306E\u305D\u3070\u306B\u3044\u308B\u3088\u3002\n\n\u30D1\u30D1\u306E\u3053\u3068\u3092\u5FD8\u308C\u306A\u304F\u3066\u3044\u3044\u3002\n\n\u3060\u3051\u3069\u3001\u30D1\u30D1\u3092\u5F85\u305F\u306A\u304F\u3066\u3082\u3044\u3044\u3093\u3060\u3088\u3002\n\n\u305F\u304F\u3055\u3093\u904A\u3093\u3067\u3001\u305F\u304F\u3055\u3093\u7B11\u3063\u3066\u306D\u3002"
  - Type: 2
    Label: MEMO END
    Lines: "\u5F1F\u306E\u60F3\u3044\u306F\u5206\u304B\u3063\u305F\u3002\n\u3051\u308C\u3069\u3001\u9CE5\u306F\u5A18\u306B\u5C4A\u304B\u306A\u304B\u3063\u305F\u3002"
    Letter: 
  - Type: 1
    Label: NORMAL END
    Lines: "\u300C\u3082\u3046\u6642\u9593\u304C\u306A\u3044\u3002\u300D\n\u305D\u306E\u8A00\u8449\u306E\u610F\u5473\u306F\u3001\u6700\u5F8C\u307E\u3067\u5206\u304B\u3089\u306A\u304B\u3063\u305F\u3002"
    Letter: 
  Title: "\u4EF6\u540D\u306A\u3057\u3002"
  RebootFormat: "\u518D\u8D77\u52D5 {0}\u56DE"
