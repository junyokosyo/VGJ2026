  Endings:
  - Type: 3
    Label: TRUE END
    Lines: "\u6D88\u305D\u3046\u3068\u3057\u305F\u306E\u306F\u3001\u601D\u3044\u51FA\u3067\u306F\u306A\u304F\u3001\n\u3072\u306A\u304C\u7ACB\u3061\u6B62\u307E\u308B\u7406\u7531\u3060\u3063\u305F\u3002"
    Letter: "\u3068\u308A\u3055\u3093\u3001\u3084\u3063\u3068\u3067\u304D\u305F\u3088\u3002\n\u5F85\u3063\u3066\u3066\u304F\u308C\u3066\u3001\u3042\u308A\u304C\u3068\u3046\u3002\n\n\u30D1\u30D1\u306E\u5199\u771F\u3082\u624B\u7D19\u3082\u3001\u305C\u3093\u3076\u7247\u3065\u3051\u307E\u3057\u305F\u3002\n\u3072\u306A\u304C\u30D1\u30D1\u3092\u63A2\u3057\u3066\u3001\u7ACB\u3061\u6B62\u307E\u3089\u306A\u3044\u3088\u3046\u306B\u3002\n\n\u3067\u3082\u3001\u3053\u306E\u3068\u308A\u3055\u3093\u3060\u3051\u306F\u6B8B\u3057\u305F\u304B\u3063\u305F\u3002\n\u30D1\u30D1\u306E\u300C\u3060\u3044\u3059\u304D\u300D\u3092\u3001\u305C\u3093\u3076\u8A70\u3081\u3066\u304A\u3044\u305F\u304B\u3089\u306D\u3002\n\n\u30D1\u30D1\u306E\u3053\u3068\u306F\u3001\u5FD8\u308C\u306A\u304F\u3066\u3044\u3044\u3002\n\u3067\u3082\u3001\u3082\u3046\u5F85\u3063\u3066\u3044\u306A\u304F\u3066\u3044\u3044\u3093\u3060\u3088\u3002\n\n\u3072\u306A\u304C\u7B11\u3046\u3068\u3001\u30D1\u30D1\u306F\u3044\u3064\u3060\u3063\u3066\u5E78\u305B\u3067\u3057\u305F\u3002"
    After: "\u9CE5\u306F\u3001\u59BB\u306E\u624B\u304B\u3089\u3072\u306A\u306E\u3082\u3068\u3078\u5C4A\u3051\u3089\u308C\u305F\u3002"
  - Type: 2
    Label: MEMO END
    Lines: "\u5F1F\u306F\u3001\u6B8B\u3055\u308C\u305F\u6642\u9593\u304C\u5C11\u306A\u3044\u3068\u77E5\u3063\u3066\u3044\u305F\u3002\n\u3072\u306A\u306B\u5FC3\u914D\u3092\u304B\u3051\u306A\u3044\u3088\u3046\u3001\u75C5\u6C17\u3092\u96A0\u3057\u3066\u3044\u305F\u3002\n\u5199\u771F\u306B\u3082\u30E1\u30E2\u306B\u3082\u3001\u3072\u306A\u3068\u306E\u601D\u3044\u51FA\u304C\u3042\u3075\u308C\u3066\u3044\u305F\u3002\n\u305D\u3057\u3066\u3001\u3042\u306E\u9CE5\u3092\u3072\u306A\u306B\u6E21\u3057\u305F\u304C\u3063\u3066\u3044\u305F\u3002\n\n\u3051\u308C\u3069\u3001\u30ED\u30C3\u30AB\u30FC\u306F\u958B\u304B\u306A\u304B\u3063\u305F\u3002\n\u9CE5\u306F\u3001\u307E\u3060\u3072\u306A\u306E\u3082\u3068\u3078\u5C4A\u3044\u3066\u3044\u306A\u3044\u3002"
    Letter: 
    After: 
  - Type: 1
    Label: NORMAL END
    Lines: "\u300C\u3082\u3046\u6642\u9593\u304C\u306A\u3044\u3002\u300D\n\u305D\u306E\u8A00\u8449\u306E\u610F\u5473\u306F\u3001\u6700\u5F8C\u307E\u3067\u5206\u304B\u3089\u306A\u304B\u3063\u305F\u3002"
    Letter: 
    After: 
