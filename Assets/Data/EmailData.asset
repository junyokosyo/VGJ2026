  DraftMails:
  - Subject: "\u4EF6\u540D\u306A\u3057"
    Body: "\u3082\u3046\u6642\u9593\u304C\u306A\u3044\u3002\n\n\u3042\u306E\u65E5\u306E\u3053\u3068\u306F\u3001\u3082\u3046\u5FD8\u308C\u3066\u307B\u3057\u3044\u3002\n\n\u5199\u771F\u3082\u3001\u624B\u7D19\u3082\u3001\u5168\u90E8\u51E6\u5206\u3059\u308B\u3002\n\n\u3082\u3046\u4E8C\u5EA6\u3068\u3001\u50D5\u3092\u63A2\u3055\u306A\u304F\u3066\u3044\u3044\u3002\n\n\u3053\u308C\u4EE5\u4E0A\u3001\u3042\u306E\u5B50\u3092\u5DFB\u304D\u8FBC\u3080\u308F\u3051\u306B\u306F\u3044\u304B\u306A\u3044\u3002\n\n\u50D5\u304C\u3044\u306A\u304F\u306A\u308C\u3070\u3001\u5168\u90E8\u7D42\u308F\u308B\u3002\n\n\u8AB0\u306B\u3082\u8A71\u3055\u306A\u3044\u3067\u307B\u3057\u3044\u3002\n\n\u3055\u3088\u306A\u3001"
    IsCut: 1
  - Subject: "\u4EF6\u540D\u306A\u3057"
    Body: "9\u6708\u300111\u6708\u300112\u6708\u300110\u6708\u3002\n\n\u30E1\u30E2\u3092\u958B\u304F\u306B\u306F\u3001\u3042\u306E\u5B50\u3068\u306E\u601D\u3044\u51FA\u306E\u6570\u3092\u3001\u3053\u306E\u9806\u756A\u3067\u78BA\u304B\u3081\u308B\u3053\u3068\u3002"
    IsCut: 0
  CannotOpenText: "\u3053\u306E\u30E1\u30FC\u30EB\u306E\u672C\u6587\u306F\u8868\u793A\u3067\u304D\u307E\u305B\u3093"
