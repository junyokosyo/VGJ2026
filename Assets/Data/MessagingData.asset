  VaultTitle: "\u975E\u8868\u793A\u306E\u30C8\u30FC\u30AF\u5C65\u6B74"
  VaultButton: "\u30D1\u30B9\u30B3\u30FC\u30C9\u3067\u8868\u793A"
  PastTitle: "\u96A0\u3055\u308C\u305F\u5C65\u6B74"
  History:
  - IsMine: 1
    Text: "\u3072\u306A\u306B\u306F\u3001\u307E\u3060\u8A71\u3055\u306A\u3044\u3067\u304A\u304D\u305F\u3044\u3002"
  - IsMine: 0
    Text: "\u3044\u3064\u304B\u306F\u8A71\u3055\u306A\u304D\u3083\u3044\u3051\u306A\u3044\u3088\u3002"
  - IsMine: 1
    Text: "\u5206\u304B\u3063\u3066\u308B\u3002\u3067\u3082\u3001\u3042\u306E\u5B50\u306B\u50D5\u306E\u3053\u3068\u3092\u5FC3\u914D\u3057\u306A\u304C\u3089\u904E\u3054\u3057\u3066\u307B\u3057\u304F\u306A\u3044\u3093\u3060\u3002"
  - IsMine: 0
    Text: "\u3072\u306A\u306F\u3001\u3042\u306A\u305F\u306B\u4F1A\u3044\u305F\u304C\u3063\u3066\u308B\u3088\u3002"
  - IsMine: 1
    Text: "\u3060\u304B\u3089\u3053\u305D\u3001\u5F85\u305F\u305B\u305F\u304F\u306A\u3044\u3093\u3060\u3002"
  - IsMine: 0
    Text: "\u3042\u306E\u9CE5\u306F\u3069\u3046\u3059\u308B\u306E\uFF1F"
  - IsMine: 1
    Text: "\u3061\u3083\u3093\u3068\u6E21\u3057\u3066\u3042\u3052\u305F\u3044\u3002\u50D5\u304C\u6E21\u305B\u306A\u304F\u3066\u3082\u3002"
  Today:
  - "\u30B9\u30DE\u30FC\u30C8\u30D5\u30A9\u30F3\u3001\u898B\u3064\u304B\u3063\u305F\u3093\u3060\u306D\u3002"
  Choice: "\u4F55\u3082\u5206\u304B\u3089\u306A\u304B\u3063\u305F\u3002"
  ChoiceReplies:
  - "\u2026\u2026\u305D\u3046\u3002"
  Locker:
  - "\u305D\u3046\u3044\u3048\u3070\u3001\u3042\u306E\u4EBA\u306E\u90E8\u5C4B\u306B\u30ED\u30C3\u30AB\u30FC\u304C\u3042\u308B\u3093\u3060\u3051\u3069\u2026\u2026\u3002"
  - "\u4F55\u304B\u5927\u5207\u306A\u3082\u306E\u3092\u5165\u308C\u3066\u3044\u305F\u307F\u305F\u3044\u306A\u306E\u3002"
  - "\u3067\u3082\u3001\u30D1\u30B9\u30EF\u30FC\u30C9\u304C\u5206\u304B\u3089\u306A\u304F\u3066\u958B\u3051\u3089\u308C\u306A\u3044\u306E\u3002"
  OpenedReplies:
  - "\u958B\u3044\u305F\u2026\u3002"
  FailedReplies:
  - "\u3093\u30FC\u3001\u3053\u308C\u3058\u3083\u958B\u304B\u306A\u3044\u307F\u305F\u3044\u306D\u3002"
  - "\u307E\u3042\u3044\u3044\u308F\u3002"
  SendButton: "\u756A\u53F7\u3092\u9001\u308B"
  ToOpenButton: "\u30ED\u30C3\u30AB\u30FC\u306E\u4E2D\u3092\u898B\u308B"
  ToEndButton: "\u7D9A\u3051\u308B"
